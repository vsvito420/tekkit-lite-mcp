# Copy the two exports into the terminal that starts chatgpt-bridge.mjs.
# Never commit or paste a real API key into a source file, mod, or Minecraft folder.
export OPENAI_API_KEY='replace-with-your-key'
export OPENAI_MODEL='gpt-5.2'

# These defaults match the existing Lycodon instance and normally need no change.
# export MINECRAFT_BRIDGE_TOKEN_FILE="$HOME/Library/Application Support/PrismLauncher/instances/Lycodon-Client(1)/minecraft/claudebridge.token"
# export CHATGPT_BRIDGE_PORT=25600
